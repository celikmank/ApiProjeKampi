@model CreateAboutDto

@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Hakkımda Alanı Ekleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        @* Validasyon özetini göster *@
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <form asp-action="CreateAbout" asp-controller="About" method="post">
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">Başlık</label>
                                <input asp-for="Title" class="form-control" />
                                <span class="text-danger" asp-validation-for="Title"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ReservationNumber" class="form-label">Rezervasyon Numarası</label>
                                <input asp-for="ReservationNumber" class="form-control" />
                                <span class="text-danger" asp-validation-for="ReservationNumber"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label">Görsel URL</label>
                                <input asp-for="ImageUrl" class="form-control" />
                                <span class="text-danger" asp-validation-for="ImageUrl"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="VideoCoverImageUrl" class="form-label">Video Kapak Görseli</label>
                                <input asp-for="VideoCoverImageUrl" class="form-control" />
                                <span class="text-danger" asp-validation-for="VideoCoverImageUrl"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="VideoUrl" class="form-label">Video Linki (Embed)</label>
                                <input asp-for="VideoUrl" class="form-control" />
                                <span class="text-danger" asp-validation-for="VideoUrl"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span class="text-danger" asp-validation-for="Description"></span>
                            </div>

                            <button type="submit" class="btn btn-primary">Hakkımda Alanı Oluştur</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
