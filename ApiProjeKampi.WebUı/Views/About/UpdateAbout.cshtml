@model GetAboutByIdDto

@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Hakkımda Alanı Güncelleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form asp-action="UpdateAbout" method="post">
                            <input type="hidden" asp-for="AboutId" />

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label"></label>
                                <input type="text" asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ReservationNumber" class="form-label"></label>
                                <input type="text" asp-for="ReservationNumber" class="form-control" />
                                <span asp-validation-for="ReservationNumber" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label"></label>
                                <input type="text" asp-for="ImageUrl" class="form-control" />
                                <span asp-validation-for="ImageUrl" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="VideoCoverImageUrl" class="form-label"></label>
                                <input type="text" asp-for="VideoCoverImageUrl" class="form-control" />
                                <span asp-validation-for="VideoCoverImageUrl" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="VideoUrl" class="form-label"></label>
                                <input type="text" asp-for="VideoUrl" class="form-control" />
                                <span asp-validation-for="VideoUrl" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-success">Hakkımda Alanı Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
