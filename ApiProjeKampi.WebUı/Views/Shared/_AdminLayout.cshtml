<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_HeadAdminLayoutComponentPartial")
<body>
    <div class="loader"></div>
    <div id="app">
        <div class="main-wrapper main-wrapper-1">
            <div class="navbar-bg"></div>
            @await Component.InvokeAsync("_NavbarAdminLayoutComponentPartial")
            @await Component.InvokeAsync("_SidebarAdminLayoutComponentPartial")
            <div class="main-content">
                @RenderBody()
                @await Component.InvokeAsync("_RightSettingsAdminLayoutComponentPartial")
            </div>
            <footer class="main-footer">
                <div class="footer-left">
                    <a href="templateshub.net">Templateshub</a>
                </div>
                <div class="footer-right"></div>
            </footer>
        </div>
    </div>
    <script src="~/Otika/assets/js/app.min.js"></script>
    <script src="~/Otika/assets/js/scripts.js"></script>
    <script src="~/Otika/assets/js/custom.js"></script>
    @await Component.InvokeAsync("_RightSettingsAdminLayoutComponentPartial")
</body>
</html>